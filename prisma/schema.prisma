// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  description         String
  primaryCategories   String[]
  secondaryCategories String[] @default([])
  district            String
  addressFreeText     String
  latitude            Float
  longitude           Float
  location            Unsupported("geography(Point,4326)")?
  searchable          Unsupported("tsvector")?
  attributes          Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  hours               BusinessHours[]
  hoursOverrides      BusinessHoursOverride[]
  photos              BusinessPhoto[]

  @@index([district])
  @@index([searchable], type: Gin, map: "business_searchable_gin_idx")
}

model BusinessHours {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  openTime        String
  closeTime       String
  crossesMidnight Boolean  @default(false)

  @@index([businessId, dayOfWeek])
}

model BusinessHoursOverride {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  isClosed        Boolean  @default(true)
  openTime        String?
  closeTime       String?
  crossesMidnight Boolean  @default(false)

  @@unique([businessId, date])
}

model BusinessPhoto {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  sortOrder   Int      @default(0)
  isMenuPhoto Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([businessId])
}

model User {
  id                   String   @id @default(cuid())
  phone                String   @unique
  name                 String?
  email                String?  @unique
  languagePref         String   @default("en")
  hasSeenProfilePrompt Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model OtpChallenge {
  id           String    @id @default(cuid())
  phone        String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone, expiresAt])
}
